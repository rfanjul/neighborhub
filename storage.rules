rules_version = '2';

// Pegar en Firebase Console -> Storage -> Rules -> Publish.
service firebase.storage {
  match /b/{bucket}/o {

    // Foto de perfil: pública, como el avatar de cualquier app.
    match /profile-photos/{userId}.jpg {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Fotos de los servicios: las ve cualquier vecino con sesión, y solo
    // las sube quien publica el servicio, bajo su propia carpeta.
    match /service-photos/{userId}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
