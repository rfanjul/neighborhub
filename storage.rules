rules_version = '2';

// Se publican con `npm run rules:deploy` (o pegándolas en la consola).
service firebase.storage {
  match /b/{bucket}/o {

    // Foto de perfil: pública, como el avatar de cualquier app. El archivo
    // se llama <uid>.jpg, y eso se comprueba en la condición porque el
    // validador no admite extensiones dentro del patrón de la ruta.
    match /profile-photos/{file} {
      allow read: if true;
      allow create, update: if request.auth != null
                   && file == request.auth.uid + '.jpg'
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      // Al borrar no hay request.resource: basta con que sea la suya.
      allow delete: if request.auth != null && file == request.auth.uid + '.jpg';
    }

    // Fotos de los servicios: las ve cualquier vecino con sesión, y solo
    // las sube quien publica el servicio, bajo su propia carpeta.
    match /service-photos/{userId}/{file} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      // Quitar una foto al editar un servicio, o todas al borrar la cuenta.
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
