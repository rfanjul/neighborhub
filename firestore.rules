rules_version = '2';

// Se publican con `npm run rules:deploy` (o pegándolas en la consola).
// Están cubiertas por rules/__tests__/firestore.rules.test.ts, que se ejecuta
// contra el emulador con `npm run test:rules`.
//
// Siguen sin un rol de admin: la moderación (aprobar servicios, ajustar
// créditos o verificar identidades) se hace desde la consola o con el Admin SDK, que
// se saltan estas reglas.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    /** Campos que cambia esta escritura respecto al documento guardado. */
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    match /users/{userId} {
      allow read: if signedIn();

      // El perfil nace a cero: nadie empieza con créditos, valoración,
      // nivel o verificación que no se haya ganado.
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.credits == 0
        && request.resource.data.rating == 0
        && request.resource.data.level == 1
        && request.resource.data.servicesCompleted == 0
        && request.resource.data.get('ratingSum', 0) == 0
        && request.resource.data.get('ratingCount', 0) == 0
        && request.resource.data.identityVerified == false;

      /**
       * Quien recibe ayuda la valora: en la misma escritura crea la reseña
       * (reviews/<servicio>, apuntada en lastReviewId) y suma esa nota y una
       * ayuda más al perfil de quien ayudó. Una vez por servicio.
       */
      function recibeValoracion() {
        let id = request.resource.data.lastReviewId;
        let resena = getAfter(/databases/$(database)/documents/reviews/$(id)).data;
        return request.auth.uid != userId
          && changedKeys().hasOnly(['ratingSum', 'ratingCount', 'servicesCompleted', 'lastReviewId'])
          && !exists(/databases/$(database)/documents/reviews/$(id))
          && resena.reviewerId == request.auth.uid
          && resena.revieweeId == userId
          && request.resource.data.ratingCount == resource.data.get('ratingCount', 0) + 1
          && request.resource.data.ratingSum == resource.data.get('ratingSum', 0) + resena.rating
          && request.resource.data.servicesCompleted == resource.data.get('servicesCompleted', 0) + 1;
      }

      // Cada uno edita solo sus datos personales. Créditos, nivel y
      // verificación los mueve el servidor; la valoración, las reseñas.
      allow update: if signedIn() && (
        (request.auth.uid == userId
          && changedKeys().hasOnly([
            'name', 'bio', 'dateOfBirth', 'city', 'postalCode', 'country',
            'languages', 'onboardingCompleted', 'photoURL'
          ]))
        || recibeValoracion()
      );

      // Borrar la cuenta desde la app: cada uno borra solo su perfil.
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /helpRequests/{requestId} {
      function isRequester() {
        return resource.data.requesterId == request.auth.uid;
      }
      function isHelper() {
        return resource.data.helperId == request.auth.uid;
      }
      /** Transiciones permitidas una vez elegida la persona que ayuda. */
      function avanza(desde, hasta) {
        return (desde == 'accepted' && hasta in ['in_progress', 'completed'])
          || (desde == 'in_progress' && hasta == 'completed');
      }

      allow read: if signedIn() && (
        resource.data.status == 'approved' || isRequester() || isHelper()
      );

      // Se publica siempre pendiente de revisión y a nombre propio.
      allow create: if signedIn()
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.status == 'pending';

      allow update: if signedIn() && (
        // Quien publica elige a una de las personas que han ofertado. Solo
        // mientras está aprobado (así solo se elige una vez) y solo a alguien
        // con una oferta registrada.
        (isRequester()
          && resource.data.status == 'approved'
          && request.resource.data.status == 'accepted'
          && exists(/databases/$(database)/documents/applications/$(requestId + '_' + request.resource.data.helperId))
          && changedKeys().hasOnly(['status', 'helperId', 'helperName', 'updatedAt']))
        ||
        // Quien publica edita el contenido mientras no haya elegido a nadie
        // (pendiente o aprobado), pero nunca el estado (aprobar es cosa del
        // admin) ni quién pide o quién ayuda.
        (isRequester()
          && resource.data.status in ['pending', 'approved']
          && !changedKeys().hasAny(['status', 'requesterId', 'requesterName', 'helperId']))
        ||
        // Una vez aceptado, las dos partes avanzan el trabajo hacia delante,
        // tocando solo el estado.
        ((isRequester() || isHelper())
          && avanza(resource.data.status, request.resource.data.status)
          && changedKeys().hasOnly(['status', 'updatedAt'])) ||

        // Quien publica lo da por terminado valorando a quien ayudó: pasa a
        // valorado en la misma escritura que crea su reseña, y solo una vez.
        (isRequester()
          && resource.data.status in ['accepted', 'in_progress', 'completed']
          && request.resource.data.status == 'rated'
          && changedKeys().hasOnly(['status', 'updatedAt'])
          && !exists(/databases/$(database)/documents/reviews/$(requestId))
          && existsAfter(/databases/$(database)/documents/reviews/$(requestId)))
      );

      // Al borrar la cuenta se van los servicios propios que aún no tienen a
      // nadie elegido; los que ya implican a otra persona se conservan.
      allow delete: if signedIn() && isRequester() && resource.data.status in ['pending', 'approved'];

      match /messages/{messageId} {
        function isParticipant() {
          let pedido = get(/databases/$(database)/documents/helpRequests/$(requestId)).data;
          return pedido.requesterId == request.auth.uid || pedido.helperId == request.auth.uid;
        }

        // Solo las dos partes del servicio leen y escriben la conversación,
        // y cada mensaje va firmado por quien lo manda.
        allow read: if signedIn() && isParticipant();
        allow create: if signedIn()
          && isParticipant()
          && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Ofertas: una por persona y servicio (id = <servicio>_<uid>).
    match /applications/{applicationId} {
      function servicio(id) {
        return get(/databases/$(database)/documents/helpRequests/$(id)).data;
      }

      // La ve quien la hace y quien publicó el servicio.
      allow read: if signedIn() && (
        resource.data.applicantId == request.auth.uid ||
        resource.data.requesterId == request.auth.uid
      );

      // Se oferta a nombre propio, sobre un servicio aprobado y ajeno, y la
      // oferta nace pendiente.
      allow create: if signedIn()
        && request.resource.data.applicantId == request.auth.uid
        && applicationId == request.resource.data.serviceId + '_' + request.auth.uid
        && request.resource.data.status == 'pending'
        && servicio(request.resource.data.serviceId).status == 'approved'
        && servicio(request.resource.data.serviceId).requesterId != request.auth.uid
        && request.resource.data.requesterId == servicio(request.resource.data.serviceId).requesterId;

      // Solo quien publicó el servicio la selecciona o la rechaza.
      allow update: if signedIn()
        && resource.data.requesterId == request.auth.uid
        && request.resource.data.status in ['selected', 'rejected']
        && changedKeys().hasOnly(['status', 'updatedAt']);

      // Retirar una oferta pendiente propia, o las recibidas en un servicio
      // propio que aún está abierto (al borrar la cuenta).
      allow delete: if signedIn() && (
        (resource.data.applicantId == request.auth.uid && resource.data.status == 'pending') ||
        (resource.data.requesterId == request.auth.uid
          && servicio(resource.data.serviceId).status in ['pending', 'approved'])
      );
    }

    // Mensajes del formulario de contacto de la web: cualquiera puede
    // escribir uno bien formado; nadie los lee desde fuera (se revisan en
    // la consola de Firebase).
    match /contactMessages/{id} {
      allow create: if request.resource.data.keys().hasOnly(['tipo', 'nombre', 'email', 'mensaje', 'referencia', 'origen', 'idioma', 'createdAt'])
        && request.resource.data.get('idioma', 'en') in ['en', 'de', 'es']
        && request.resource.data.tipo in ['pregunta', 'problema', 'reportar', 'borrar-cuenta', 'otro']
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 200
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+[.][^@\\s]+$')
        && request.resource.data.mensaje is string
        && request.resource.data.mensaje.size() >= 10
        && request.resource.data.mensaje.size() <= 3000
        && request.resource.data.get('nombre', '').size() <= 100
        && request.resource.data.get('referencia', '').size() <= 200
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    // Reseñas: una por servicio (id = servicio), de quien lo publicó a
    // quien le ayudó. Públicas para cualquiera con sesión.
    match /reviews/{serviceId} {
      function pedido() {
        return get(/databases/$(database)/documents/helpRequests/$(serviceId)).data;
      }

      allow read: if signedIn();

      // Solo al cerrar el servicio (pasa a valorado) y sumando la nota al
      // perfil de quien ayudó, todo en la misma escritura.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'serviceId', 'serviceTitle', 'reviewerId', 'reviewerName', 'reviewerPhotoURL',
          'revieweeId', 'rating', 'comment', 'createdAt'
        ])
        && request.resource.data.serviceId == serviceId
        && request.resource.data.reviewerId == request.auth.uid
        && pedido().requesterId == request.auth.uid
        && pedido().helperId == request.resource.data.revieweeId
        && pedido().status in ['accepted', 'in_progress', 'completed']
        && getAfter(/databases/$(database)/documents/helpRequests/$(serviceId)).data.status == 'rated'
        && getAfter(/databases/$(database)/documents/users/$(request.resource.data.revieweeId)).data.lastReviewId == serviceId
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 500;

      allow update, delete: if false;
    }
  }
}
