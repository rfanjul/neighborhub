# Firebase (Console -> Project settings -> General -> Your apps -> Web app config)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Sign-In (Firebase Console -> Authentication -> Sign-in method ->
# Google -> Web SDK configuration -> Web client ID)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# Google Sign-In nativo en iOS. Los dos valores salen del GoogleService-Info.plist
# que descargas al registrar la app iOS (bundle com.rfanjul.logindemo) en Firebase:
#   CLIENT_ID          -> EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID
#   REVERSED_CLIENT_ID -> GOOGLE_IOS_URL_SCHEME (empieza por com.googleusercontent.apps.)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
GOOGLE_IOS_URL_SCHEME=
